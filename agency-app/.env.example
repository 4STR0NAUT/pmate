# --- Retell ---
# Get this from https://dashboard.retellai.com  -> API Keys
RETELL_API_KEY=

# The voice for the agent. Browse voices in the Retell dashboard.
# (11labs / openai / deepgram voices are referenced by voice_id)
RETELL_VOICE_ID=11labs-Adrian

# After you create an agent (npm run create-agent), paste its id here
RETELL_AGENT_ID=

# A Retell phone number (E.164, e.g. +14155551234) used as the caller id for test calls.
# Buy/import one in the Retell dashboard, then paste it here.
RETELL_FROM_NUMBER=

# Where Retell sends call events. In local dev, expose your server with a tunnel
# (e.g. `npx localtunnel --port 3000` or ngrok) and put that public URL here + /webhook/retell
PUBLIC_WEBHOOK_URL=

# --- Server ---
PORT=3000

# --- Test call target (your own phone, E.164) ---
TEST_TO_NUMBER=
